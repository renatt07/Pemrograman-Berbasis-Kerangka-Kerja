<Window x:Class="StudentManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System" 
        Width="1280" Height="768" 
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F6">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Kiri (Form) -->
            <ColumnDefinition Width="340"/>
            <!-- Main Area Kanan (Data) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR KIRI (DARK MODE) ================= -->
        <Border Grid.Column="0" Background="#1E293B" Padding="25">
            <StackPanel>
                <!-- Logo / Header Text -->
                <TextBlock Text="Student" Foreground="#38BDF8" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Management" Foreground="White" FontSize="24" FontWeight="Light" Margin="0,0,0,5"/>
                <Border Height="2" Background="#38BDF8" Width="50" HorizontalAlignment="Left" Margin="0,0,0,25"/>

                <TextBlock Text="FORM DATA MAHASISWA" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,15"/>

                <!-- Form Inputs -->
                <TextBlock Text="NIM" Foreground="#E2E8F0" Margin="0,5,0,5"/>
                <TextBox Text="{Binding SelectedStudent.NIM, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>
                
                <TextBlock Text="Nama Lengkap" Foreground="#E2E8F0" Margin="0,5,0,5"/>
                <TextBox Text="{Binding SelectedStudent.Nama, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>
                
                <TextBlock Text="Jurusan" Foreground="#E2E8F0" Margin="0,5,0,5"/>
                <ComboBox SelectedValue="{Binding SelectedStudent.Jurusan, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Padding="8" Background="#334155" Foreground="Black" BorderThickness="0" Margin="0,0,0,10">
                    <ComboBoxItem>Teknik Informatika</ComboBoxItem>
                    <ComboBoxItem>Sistem Informasi</ComboBoxItem>
                    <ComboBoxItem>Teknologi Informasi</ComboBoxItem>
                    <ComboBoxItem>Teknik Komputer</ComboBoxItem>
                    <ComboBoxItem>Teknik Elektro</ComboBoxItem>
                </ComboBox>
                
                <TextBlock Text="Gender" Foreground="#E2E8F0" Margin="0,5,0,5"/>
                <ComboBox SelectedValue="{Binding SelectedStudent.Gender, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Padding="8" Background="#334155" Foreground="Black" BorderThickness="0" Margin="0,0,0,10">
                    <ComboBoxItem>Laki-laki</ComboBoxItem>
                    <ComboBoxItem>Perempuan</ComboBoxItem>
                </ComboBox>
                
                <TextBlock Text="Alamat Email" Foreground="#E2E8F0" Margin="0,5,0,5"/>
                <TextBox Text="{Binding SelectedStudent.Email, UpdateSourceTrigger=PropertyChanged}" Padding="8" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,0,25"/>
                
                <!-- Action Buttons -->
                <Button Content="Simpan Data" Command="{Binding SaveCommand}" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="0,12" Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Reset" Command="{Binding ResetCommand}" Background="#64748B" Foreground="White" Padding="0,10" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="Hapus" Command="{Binding DeleteCommand}" Background="#EF4444" Foreground="White" Padding="0,10" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= MAIN AREA KANAN ================= -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Baris 1: Kartu Statistik (Cards) -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
            <!-- Card 1: Total -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="TOTAL" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalStudents}" Foreground="#0F172A" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <!-- Card 2: Informatika -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="TEKNIK INFORMATIKA" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalTeknikInformatika}" Foreground="#38BDF8" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <!-- Card 3: Sistem Info -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="SISTEM INFORMASI" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalSistemInformasi}" Foreground="#38BDF8" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <!-- Card 4: Teknologi Info -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="TEKNOLOGI INFORMASI" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalTeknologiInformasi}" Foreground="#38BDF8" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <!-- Card 5: Teknik Komp -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TEKNIK KOMPUTER" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalTeknikKomputer}" Foreground="#38BDF8" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <!-- Card 6: Teknik Elektro (BARU) -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TEKNIK ELEKTRO" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalTeknikElektro}" Foreground="#38BDF8" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <!-- Card 7: Laki-laki -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="LAKI-LAKI" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalLakiLaki}" Foreground="#10B981" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <!-- Card 8: Perempuan -->
            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="PEREMPUAN" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalPerempuan}" Foreground="#10B981" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

            <!-- Baris 2: Search Bar dengan Placeholder/Note -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="12" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" 
                             Background="White" VerticalContentAlignment="Center"/>
                    
                    <!-- Ini adalah Watermark/Note -->
                    <TextBlock IsHitTestVisible="False" Text="Cari Nama / NRP / Jurusan..." 
                               VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#94A3B8" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Content="Cari Data" Command="{Binding SearchCommand}" 
                        Background="#38BDF8" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <!-- Baris 3: DataGrid -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10">
                <DataGrid ItemsSource="{Binding Students}" 
                          SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          AlternatingRowBackground="#F8FAFC" 
                          RowBackground="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          BorderThickness="0"
                          RowHeight="35"
                          HeadersVisibility="Column">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NRP" Binding="{Binding NIM}" Width="*"/>
                        <DataGridTextColumn Header="Nama Mahasiswa" Binding="{Binding Nama}" Width="2.5*"/>
                        <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="1.5*"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>