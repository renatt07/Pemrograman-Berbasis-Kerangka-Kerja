# Dependency Composer
vendor/

# Konfigurasi lokal & kredensial database (file template env tetap ikut)
.env
!env
!.env.example

# File runtime CodeIgniter 4 (cache, session, log, debugbar)
**/writable/cache/*
**/writable/debugbar/*
**/writable/logs/*
**/writable/session/*
**/writable/uploads/*
!**/writable/*/index.html
!**/writable/*/.htaccess
!**/writable/*/.gitkeep

# Cache pengujian & build
.phpunit.result.cache
**/build/

# File sampah OS & editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.log